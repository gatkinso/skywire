# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.json]
indent_size = unset

[*.md]
trim_trailing_whitespace = false

# Exactly what wiregen writes; see src/test/golden/CMakeLists.txt.
[src/test/golden/*/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
