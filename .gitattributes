# gofmt and rustfmt reject CRLF, so keep these LF even where Git converts
# line endings on checkout (core.autocrlf=true, the Windows default).
*.go    text eol=lf
*.rs    text eol=lf

*.bin   binary
*.bson  binary
*.pb    binary

# Golden files are compared byte for byte with what wiregen writes (LF).
src/test/golden/*/** -text
