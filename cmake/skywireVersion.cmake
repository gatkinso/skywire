# Writes skywire_version.h. Run at build time with cmake -P, so the git
# revision follows commits without a reconfigure:
#
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -DVERSION=<x.y.z>
#         [-DCOMPILER=<id version>] [-DBUILD_TYPE=<config>] [-DPLATFORM=<os arch>]
#         [-DOPTIONS=<build options>] -P skywireVersion.cmake
#
# The commit, branch and commit date come from git; the rest is passed in.
# The header is rewritten only when its contents change, so an unchanged
# revision does not rebuild anything. Outside a git checkout (a source
# tarball) the revision is empty unless SKYWIRE_REVISION is set.

find_package(Git QUIET)

# Sets VAR to the output of git ARGS in SOURCE_DIR, or empty if that fails.
function(git_output VAR)
    set(OUT "")
    if(GIT_FOUND)
        execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE_DIR} ${ARGN}
                        OUTPUT_VARIABLE OUT
                        OUTPUT_STRIP_TRAILING_WHITESPACE
                        ERROR_QUIET
                        RESULT_VARIABLE RESULT)
        if(NOT RESULT EQUAL 0)
            set(OUT "")
        endif()
    endif()
    set(${VAR} "${OUT}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED SKYWIRE_REVISION OR SKYWIRE_REVISION STREQUAL "")
    git_output(SKYWIRE_REVISION describe --tags --always --dirty)
endif()
git_output(COMMIT rev-parse HEAD)
git_output(COMMIT_DATE log -1 --format=%cs)
git_output(BRANCH rev-parse --abbrev-ref HEAD)
if(BRANCH STREQUAL "HEAD")
    set(BRANCH "")   # detached
endif()

string(REPLACE "." ";" VERSION_PARTS "${VERSION}")
list(GET VERSION_PARTS 0 VERSION_MAJOR)
list(GET VERSION_PARTS 1 VERSION_MINOR)
list(GET VERSION_PARTS 2 VERSION_PATCH)

set(CONTENT "// Generated by cmake/skywireVersion.cmake; do not edit.
#pragma once

#define SKYWIRE_VERSION_MAJOR ${VERSION_MAJOR}
#define SKYWIRE_VERSION_MINOR ${VERSION_MINOR}
#define SKYWIRE_VERSION_PATCH ${VERSION_PATCH}
#define SKYWIRE_VERSION \"${VERSION}\"
#define SKYWIRE_REVISION \"${SKYWIRE_REVISION}\"
#define SKYWIRE_COMMIT \"${COMMIT}\"
#define SKYWIRE_COMMIT_DATE \"${COMMIT_DATE}\"
#define SKYWIRE_BRANCH \"${BRANCH}\"
#define SKYWIRE_COMPILER \"${COMPILER}\"
#define SKYWIRE_BUILD_TYPE \"${BUILD_TYPE}\"
#define SKYWIRE_PLATFORM \"${PLATFORM}\"
#define SKYWIRE_BUILD_OPTIONS \"${OPTIONS}\"
")

set(EXISTING "")
if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} EXISTING)
endif()
if(NOT EXISTING STREQUAL CONTENT)
    file(WRITE ${OUTPUT} "${CONTENT}")
endif()
