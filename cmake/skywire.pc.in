prefix=${pcfiledir}/@SKYWIRE_PC_PREFIX@
bindir=${prefix}/@CMAKE_INSTALL_BINDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
datadir=${prefix}/@CMAKE_INSTALL_DATADIR@
wiregen=${bindir}/wiregen@CMAKE_EXECUTABLE_SUFFIX@
langdir=${datadir}/skywire/lang
runtimedir=${datadir}/skywire/runtime

Name: skywire
Description: Runtime headers for C and C++ generated by wiregen (C++ also needs protozero)
URL: https://github.com/gatkinso/skywire
Version: @PROJECT_VERSION@
Cflags: -I${includedir}/skywire
