//
//  A third-party Swift package that depends on skywire's Package.swift for
//  SWStream. run_swiftpm_test.cmake fills in the path to the source tree and
//  its package identity: for a path dependency that is the directory name, in
//  lower case, not the name in its Package.swift.

import PackageDescription

let package = Package(
    name: "consumer",
    dependencies: [
        .package(path: "@SOURCE_DIR@"),
    ],
    targets: [
        .executableTarget(name: "consumer", dependencies: [.product(name: "Skywire", package: "@PACKAGE_ID@")]),
    ]
)
