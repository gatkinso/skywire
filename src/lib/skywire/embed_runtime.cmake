#
# Writes OUTPUT, a C++ source defining skyloupe::runtime_source(), which gives
# the text of each runtime file wiregen writes beside generated code (the
# JSON, XML and BSON helpers of the languages that have no runtime of their
# own). LANG_DIR is lang/, FILES the files under it, joined with |. Each file
# is ASCII, split into raw string literals of at most 8000 bytes, as MSVC
# limits a literal's length.
#
#   cmake -DLANG_DIR=... -DFILES="python/skywire_text.py|..." -DOUTPUT=... -P embed_runtime.cmake

string(REPLACE "|" ";" FILES "${FILES}")
set(delimiter "swrt")
set(body "")
foreach(name IN LISTS FILES)
    file(READ ${LANG_DIR}/${name} content)
    if(content MATCHES "\\)${delimiter}\"")
        message(FATAL_ERROR "${name} holds the raw string delimiter")
    endif()
    string(LENGTH "${content}" length)
    string(APPEND body "        { \"${name}\", std::string()")
    set(at 0)
    while(at LESS length)
        string(SUBSTRING "${content}" ${at} 8000 chunk)
        string(APPEND body "\n            + R\"${delimiter}(${chunk})${delimiter}\"")
        math(EXPR at "${at} + 8000")
    endwhile()
    string(APPEND body " },\n")
endforeach()

file(WRITE ${OUTPUT}.tmp "// Generated by embed_runtime.cmake from lang/. Do not edit.

#include <map>
#include \"runtime_sources.h\"

namespace skyloupe
{

const std::string& runtime_source(const std::string& name)
{
    static const std::map<std::string, std::string> sources = {
${body}    };
    static const std::string none;
    auto it = sources.find(name);
    return it == sources.end() ? none : it->second;
}

}
")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUTPUT}.tmp ${OUTPUT})
